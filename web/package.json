{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync || echo \"\"",
		"api": "openapi-typescript openapi.json -o src/lib/api.gen.ts",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@lucide/svelte": "1.61.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/svelte-query": "6.3.5",
		"@types/leaflet": "1.9.22",
		"@types/node": "26.6.5",
		"bits-ui": "2.20.0",
		"cn": "0.5.0",
		"leaflet": "1.9.4",
		"openapi-fetch": "0.17.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"svelte-sonner": "1.2.1",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		},
		"cookie": "0.7.2"
	}
}

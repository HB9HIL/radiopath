{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "npmrc": "allow-remote=all",
    "postUpdateOptions": [
        "gomodTidy"
    ],
    "packageRules": [
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["/(^|/)valkey/valkey$/"],
            "allowedVersions": "/^9\\.1(\\.|-|$)/"
        },
        {
            "matchPackageNames": ["go", "/(^|/)golang$/"],
            "allowedVersions": "/^1\\.27(\\.|-|$)/"
        },
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["/(^|/)postgis$/"],
            "allowedVersions": "/^17-/"
        }
    ]
}

{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "postUpdateOptions": [
        "gomodTidy"
    ],
    "packageRules": [
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["/(^|/)valkey/valkey$/"],
            "allowedVersions": "/^9\\.1(\\.|-|$)/"
        },
        {
            "matchPackageNames": ["go", "/(^|/)golang$/"],
            "allowedVersions": "/^1\\.26(\\.|-|$)/"
        },
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["/(^|/)postgis$/"],
            "allowedVersions": "/^17-/"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^e2e/e2e\\.sh$/"],
            "matchStrings": ["CYPRESS_IMAGE:=(?<depName>cypress/included):(?<currentValue>[^}\"]+)"],
            "datasourceTemplate": "docker"
        }
    ]
}

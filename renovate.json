{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "npmrc": "allow-remote=all",
    "postUpdateOptions": [
        "gomodTidy"
    ],
    "packageRules": [
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["/(^|/)valkey/valkey$/"],
            "allowedVersions": "/^9\\.1(\\.|-|$)/"
        },
        {
            "matchPackageNames": ["go", "/(^|/)golang$/"],
            "allowedVersions": "/^1\\.27(\\.|-|$)/"
        },
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["/(^|/)postgis$/"],
            "allowedVersions": "/^17-/"
        },
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["node"],
            "allowedVersions": "/^26(\\.|-|$)/"
        },
        {
            "description": "SvelteKit 3 is too new: bits-ui (via runed) does not support it yet; adapter-static 4 needs it",
            "matchDatasources": ["npm"],
            "matchPackageNames": ["@sveltejs/kit"],
            "allowedVersions": "<3.0.0"
        },
        {
            "matchDatasources": ["npm"],
            "matchPackageNames": ["@sveltejs/adapter-static"],
            "allowedVersions": "<4.0.0"
        }
    ]
}
